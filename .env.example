# Copy to .env and fill in. Never commit the filled file.

# HTTP port. Server binds 127.0.0.1 only.
PORT=4600

# Path to the SQLite database file.
SANAD_DB=

# Set to 1 to disable every language-model call (test mode).
SANAD_NO_BRAIN=

# Set to 1 to disable embeddings and use the lexical matcher alone.
SANAD_NO_EMBED=

# Optional external model helper. Receives the prompt as its first argument
# and prints JSON on stdout. Unset means no model call is ever made.
SANAD_BRAIN_CMD=
SANAD_BRAIN_ARGS=

# Optional embedding model id (defaults to the multilingual MiniLM).
SANAD_EMBED_MODEL=

# Optional Telegram channel. Leave empty to keep it off.
SANAD_TG_TOKEN=
SANAD_TG_ALLOWLIST=
SANAD_TG_ADMIN=

# Optional project root override for tools/sanad-guardian.ps1.
SANAD_ROOT=
